            return;
        }

        if (customItemSlots < 0 || customItemSlots > 10)
        {
            validationErrors.Add("Slots must be between 0 and 10");
            StateHasChanged();
            return;
        }

        if (customItemEffect.Length > 200)
        {
            validationErrors.Add("Effect description must be 200 characters or less");
            StateHasChanged();
            return;
        }

        customItemSaving = true;
        StateHasChanged();

        try
        {
            var customItem = new Equipment
            {
                Name = customItemName.Trim(),
                Type = "item",
                Cost = customItemCost,
                Slots = customItemSlots,
                Effect = string.IsNullOrWhiteSpace(customItemEffect) ? null : customItemEffect.Trim(),
