    private List<string> GetUnaffordableEquipmentIds()
    {
        if (warband == null) return new();

        var disabled = new List<string>();

        // If no trader selected, disable only buy button (equipment still selectable via Assign)
        if (selectedTrader == null)
        {
            return disabled;
        }

        // Trader selected - disable buy for equipment the warband can't afford
        foreach (var equipment in allEquipment)
        {
            if (equipment.IsRelic)
            {
                // Grey out if unique and already acquired
                if (equipment.Unique && warband.AcquiredRelicIds.Contains(equipment.Id))
                {
                    disabled.Add(equipment.Id);
                }
                // Also check affordability (relics have flat 100G price)
                else if (!warband.CanAfford(100))
                {
                    disabled.Add(equipment.Id);
                }
            }
            else
            {
                // For weapons, armor, items - check trader pricing
                if (equipment.Cost > 0)
                {
                    var price = selectedTrader.CalculateBuyPrice(equipment.Cost);
                    if (!warband.CanAfford(price))
                    {
                        disabled.Add(equipment.Id);
                    }
                }
            }
        }

        return disabled;
    }

