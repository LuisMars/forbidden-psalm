    }

    private void RollMerchantInventory()
    {
        if (selectedTrader == null || !selectedTrader.HasLimitedInventory) return;

        merchantInventoryIds.Clear();
        var random = new Random();

        // Roll weapons (max according to trader)
        var weaponCount = selectedTrader.MaxWeapons ?? 0;
        if (weaponCount > 0)
        {
            var weapons = allEquipment.Where(e => e.IsWeapon).ToList();
            if (weapons.Any())
            {
                var selectedWeapons = weapons.OrderBy(x => random.Next()).Take(weaponCount);
                merchantInventoryIds.AddRange(selectedWeapons.Select(w => w.Id));
            }
        }

        // Roll armor (max according to trader)
        var armorCount = selectedTrader.MaxArmor ?? 0;
        if (armorCount > 0)
        {
            var armors = allEquipment.Where(e => e.IsArmor).ToList();
            if (armors.Any())
            {
                var selectedArmors = armors.OrderBy(x => random.Next()).Take(armorCount);
                merchantInventoryIds.AddRange(selectedArmors.Select(a => a.Id));
            }
        }

        // Roll items (max according to trader)
        var itemCount = selectedTrader.MaxEquipment ?? 0;
        if (itemCount > 0)
        {
            var items = allEquipment.Where(e => e.IsItem).ToList();
            if (items.Any())
            {
                var selectedItems = items.OrderBy(x => random.Next()).Take(itemCount);
                merchantInventoryIds.AddRange(selectedItems.Select(i => i.Id));
            }
        }

        StateHasChanged();
    }

    private void ClearMerchantInventory()
    {
        merchantInventoryIds.Clear();
        StateHasChanged();
    }

    private async Task RollRandomRelic()
    {
        if (character == null || warband == null) return;

        var relics = allEquipment.Where(e => e.IsRelic).ToList();
        if (!relics.Any()) return;

        try
        {
            // Filter out already acquired unique relics
            var availableRelics = relics
                .Where(r => !r.Unique || !warband.AcquiredRelicIds.Contains(r.Id))
                .ToList();

            if (!availableRelics.Any())
            {
                validationErrors.Add("No relics available! All unique relics have been acquired.");
                StateHasChanged();
                return;
            }

            // Randomly select a relic
            var random = new Random();
            var selectedRelic = availableRelics[random.Next(availableRelics.Count)];

            // Assign to character (this will auto-mark unique relics as acquired)
            await StateService.AddEquipmentToCharacterAsync(warband.Id, character.Id, selectedRelic.Id, "relic");

            // Refresh data
            await LoadData();
            StateHasChanged();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to roll random relic");
            validationErrors.Add($"Failed to roll relic: {ex.Message}");
            StateHasChanged();
        }
    }

    private List<Equipment> GetFilteredEquipment()
    {
        if (selectedTrader == null)
        {
            // No trader selected - show all equipment for assignment
            return allEquipment;
        }

        // Trader selected - filter based on what they sell
        var filtered = new List<Equipment>();

        // Filter relics
        if (selectedTrader.SellsRelics)
        {
            filtered.AddRange(allEquipment.Where(e => e.IsRelic));
        }

        // Filter weapons, armor, items based on merchant inventory
        if (selectedTrader.HasLimitedInventory)
        {
            // Only show items in merchant's inventory
            filtered.AddRange(allEquipment.Where(e =>
                !e.IsRelic && merchantInventoryIds.Contains(e.Id)));
        }
        else
        {
            // Show all non-relic equipment
            filtered.AddRange(allEquipment.Where(e => !e.IsRelic));
        }

        return filtered;
    }

