@page "/warband/{WarbandId}/character/{CharacterId}"
@page "/warband/{WarbandId}/character/new"
@using ForbiddenPsalmBuilder.Core.Services.State
@using ForbiddenPsalmBuilder.Core.Models.Warband
@using ForbiddenPsalmBuilder.Core.Models.Character
@using ForbiddenPsalmBuilder.Core.DTOs
@using ForbiddenPsalmBuilder.Core.Services
@using ForbiddenPsalmBuilder.Core.Models.Selection
@using ForbiddenPsalmBuilder.Blazor.Components
@using Microsoft.AspNetCore.Components.Forms
@inject IGameStateService StateService
@inject EquipmentService EquipmentService
@inject TraderService TraderService
@inject FeatFlawService FeatFlawService
@inject InjuryService InjuryService
@inject SpellService SpellService
@inject NavigationManager Navigation
@inject ILogger<CharacterEdit> Logger
@inject IJSRuntime JSRuntime
@using Microsoft.Extensions.Logging
@using Microsoft.JSInterop
<PageTitle>
    @(IsNewCharacter ? "New Character" : $"{character?.Name}") - Forbidden Psalm Builder
</PageTitle>
<PageHeader
    Title="@(IsNewCharacter ? "New Character" : $"{character?.Name}")"
    Subtitle="@(warband?.Name ?? "Unknown Warband")"
    BreadcrumbItems="@GetBreadcrumbItems()">
    <Actions>
        <button
            type="button"
            class="btn btn-secondary"
            @onclick="GoBack">
            <i class="fas fa-arrow-left"></i>
            Back to Warband
        </button>
        @if (!IsNewCharacter)
        {
            <button
                type="button"
                class="btn btn-primary"
                @onclick="() => showRenameModal = true">
                <i class="fas fa-edit"></i>
                Rename
            </button>
        }
    </Actions>
</PageHeader>
<main class="container py-4" style="max-width: 1400px;">
    @if (isLoading)
    {
        <section class="text-center py-5">
            <div
                role="status"
                class="spinner-border text-primary mb-3"
                aria-hidden="true"></div>
            <p class="text-body-secondary">
                @(IsNewCharacter ? "Preparing character creation..." : "Loading character...")
            </p>
        </section>
    }
    else if (warband == null)
    {
        <section class="text-center py-5 alert alert-warning" role="alert">
            <i class="fas fa-exclamation-triangle fa-2x mb-3"></i>
            <h3 class="h4">Warband Not Found</h3>
            <p class="mb-3">The warband you're looking for doesn't exist or has been deleted.</p>
            <button class="btn btn-primary" @onclick="GoHome">
                <i class="fas fa-home"></i>
                Go Home
            </button>
        </section>
    }
    else
    {
        <EditForm Model="editCharacterDto" OnInvalidSubmit="HandleInvalidSubmit">
            <DataAnnotationsValidator />
            <ValidationSummary class="alert alert-danger" role="alert" />
            <div class="row g-4">
                <!-- Special Classes -->
                <section class="col-12 col-lg-6">
                    <div class="card">
                        <div class="card-body">
                            <div class="mb-3 d-flex justify-content-between align-items-center">
                                <h2 class="mb-0">Class & Background</h2>
                                @if (!IsNewCharacter && warband != null)
                                {
                                    <button
                                        type="button"
                                        class="btn btn-sm btn-primary"
                                        @onclick="OpenLevelUpModal"
                                        disabled="@(!CanLevelUp())">
                                        <i class="fas fa-level-up-alt"></i>
                                        Level Up (@characterXpCost XP)
                                    </button>
                                }
                            </div>
                            <InfoSelector
                                Items="@availableSpecialClasses"
                                @bind-SelectedId="editCharacterDto.SpecialClassId"
                                @bind-SelectedId:after="AutoSave"
                                Label="Special Class"
                                ModalLabel="Select Special Class"
                                Category="special-class"
                                AllowNone="true"
                                Searchable="true"
                                ShowCost="true"
                                ShowIcons="true"
                                CurrencySymbol="@GetCurrencySymbol()" />
                            @if (character != null)
                            {
                                <div class="mt-3 pt-3 border-top">
                                    <div class="d-flex align-items-center gap-3">
                                        <label class="form-label mb-0 fw-bold">Tragedies:</label>
                                        <NumberInput
                                            @bind-Value="character.Tragedies"
                                            @bind-Value:after="AutoSave"
                                            Min="0"
                                            Max="99"
                                            Step="1" />
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                </section>
                <!-- Character Stats -->
                <section class="col-12 col-lg-6">
                    <div class="card">
                        <div class="card-body">
                            <div class="mb-3 d-flex justify-content-between align-items-center">
                                <h2 class="mb-0">Character Stats</h2>
                                <button
                                    type="button"
                                    class="btn btn-sm btn-primary"
                                    @onclick="OpenStatArrayModal">
                                    <i class="fas fa-dice-d20"></i>
                                    Select Distribution
                                </button>
                            </div>
                            @if (character != null)
                            {
                                <CharacterStatsDisplay
                                    Character="@character"
                                    FeatOptions="@GetFeatOptions(character.Feats)"
                                    FlawOptions="@GetFlawOptions(character.Flaws)"
                                    InjuryOptions="@GetInjuryOptions(character.Injuries)"
                                    BaseAgility="@editCharacterDto.Agility"
                                    BasePresence="@editCharacterDto.Presence"
                                    BaseStrength="@editCharacterDto.Strength"
                                    BaseToughness="@editCharacterDto.Toughness" />
                            }
                            else
                            {
                                <StatsDisplay Stats="@GetMainStats()" />
                                <StatsDisplay Stats="@GetCalculatedStats()" />
                            }
                        </div>
                    </div>
                </section>
                <!-- Equipment -->
                <section class="col-12 col-lg-6">
                    <div class="card">
                        <div class="card-body">
                            <div class="mb-3">
                                <h2>Equipment</h2>
                                <SlotUsageBar UsedSlots="@GetUsedEquipmentSlots()" TotalSlots="@GetTotalEquipmentSlots()" />
                            </div>

                            <!-- Equipped Items Section -->
                            <div class="mb-4">
                                <h3 class="h5 mb-2 text-primary"><i class="fas fa-shield-alt"></i> Equipped</h3>
                                @if (character != null && character.Equipment.Any(e => e.IsEquipped))
                                {
                                    <div class="d-flex flex-column gap-2">
                                        @foreach (var equipment in character.Equipment.Where(e => e.IsEquipped))
                                        {
                                            <EquipmentCard
                                                Equipment="equipment"
                                                ShowActions="true"
                                                Traders="@availableTraders"
                                                OnMoveToStash="() => RemoveEquipment(equipment.Id)"
                                                OnSellToTrader="@(tuple => SellEquipmentToTrader(tuple.Equipment, tuple.Trader))"
                                                OnUnequip="@(e => UnequipItem(e.Id))"
                                                OnReload="@(e => HandleReload(e))"
                                                OnUnload="@(e => HandleUnload(e))"
                                                OnConsumeAmmo="@(e => HandleConsumeAmmo(e))"
                                                OnUseConsumable="@(e => HandleUseConsumable(e))" />
                                        }
                                    </div>
                                }
                                else
                                {
                                    <div class="card">
                                        <div class="card-body text-center text-muted">
                                            <small>No items equipped</small>
                                        </div>
                                    </div>
                                }
                            </div>

                            <!-- Inventory Section -->
                            <div class="mb-3">
                                <h3 class="h5 mb-2 text-secondary"><i class="fas fa-backpack"></i> Inventory</h3>
                                <small class="text-muted d-block mb-2">Items in inventory count toward slot limits but provide no benefits</small>
                                @if (character != null && character.Equipment.Any(e => !e.IsEquipped))
                                {
                                    <div class="d-flex flex-column gap-2">
                                        @foreach (var equipment in character.Equipment.Where(e => !e.IsEquipped))
                                        {
                                            <EquipmentCard
                                                Equipment="equipment"
                                                ShowActions="true"
                                                Traders="@availableTraders"
                                                OnMoveToStash="() => RemoveEquipment(equipment.Id)"
                                                OnSellToTrader="@(tuple => SellEquipmentToTrader(tuple.Equipment, tuple.Trader))"
                                                OnEquip="@(e => EquipItem(e.Id))"
                                                OnReload="@(e => HandleReload(e))"
                                                OnUnload="@(e => HandleUnload(e))"
                                                OnConsumeAmmo="@(e => HandleConsumeAmmo(e))"
                                                OnUseConsumable="@(e => HandleUseConsumable(e))" />
                                        }
                                    </div>
                                }
                                else
                                {
                                    <div class="card">
                                        <div class="card-body text-center text-muted">
                                            <small>Inventory is empty</small>
                                        </div>
                                    </div>
                                }
                            </div>

                            <div class="d-flex gap-2">
                                <button
                                    type="button"
                                    class="btn btn-primary"
                                    @onclick="OpenAddFromStashModal"
                                    disabled="@(!HasStashEquipment())">
                                    <i class="fas fa-box-open"></i>
                                    Add from Stash
                                </button>
                                <button
                                    type="button"
                                    class="btn btn-primary"
                                    @onclick="OpenAddEquipmentModal">
                                    <i class="fas fa-gift"></i>
                                    Add New Equipment
                                </button>
                                <button
                                    type="button"
                                    class="btn btn-primary"
                                    @onclick="OpenSpellModal">
                                    <i class="fas fa-magic"></i>
                                    Manage Spells
                                </button>
                            </div>
                        </div>
                    </div>
                </section>
                <!-- Feats & Flaws -->
                <section class="col-12 col-lg-6">
                    <div class="card">
                        <div class="card-body">
                            <div class="mb-3 d-flex justify-content-between align-items-center">
                                <h2 class="mb-0">Feats & Flaws</h2>
                                <button
                                    type="button"
                                    class="btn btn-sm btn-primary"
                                    @onclick="OpenFeatFlawModal">
                                    <i class="fas fa-dice-d20"></i>
                                    Manage
                                </button>
                            </div>
                            @if (character != null)
                            {
                                <FeatFlawList
                                    Feats="@GetFeatOptions(character.Feats)"
                                    Flaws="@GetFlawOptions(character.Flaws)"
                                    ShowRemove="true"
                                    ShowDetails="true"
                                    OnRemoveFeat="@RemoveFeat"
                                    OnRemoveFlaw="@RemoveFlaw" />
                            }
                        </div>
                    </div>
                </section>
                <!-- Injuries -->
                <section class="col-12 col-lg-6">
                    <div class="card">
                        <div class="card-body">
                            <div class="mb-3 d-flex justify-content-between align-items-center">
                                <h2 class="mb-0">Injuries</h2>
                                <button
                                    type="button"
                                    class="btn btn-sm btn-primary"
                                    @onclick="OpenInjuryModal">
                                    <i class="fas fa-heart-broken"></i>
                                    Manage
                                </button>
                            </div>
                            @if (character != null)
                            {
                                <InjuryList
                                    Injuries="@GetInjuryOptions(character.Injuries)"
                                    ShowDetails="true"
                                    ShowRemove="true"
                                    OnRemoveInjury="@RemoveInjury" />
                            }
                        </div>
                    </div>
                </section>
            </div>
            <ValidationErrors Errors="@validationErrors" />
        </EditForm>
    }
    <!-- Stat Array Selection Modal -->
    @if (showStatArrayModal)
    {
        <Modal IsVisible="true" OnClose="CloseStatArrayModal" ModalDialogClass="modal-fullscreen">
            <StatArraySelector
                StatArrays="@availableStatArrays"
                InitialAgility="@editCharacterDto.Agility"
                InitialPresence="@editCharacterDto.Presence"
                InitialStrength="@editCharacterDto.Strength"
                InitialToughness="@editCharacterDto.Toughness"
                OnStatsChanged="OnStatArrayStatsChanged"
                OnArraySelectionChanged="OnStatArraySelectionChanged"
                OnClose="CloseStatArrayModal" />
        </Modal>
    }
    <!-- Add Equipment from Stash Modal -->
    @if (showAddFromStashModal && character != null)
    {
        <Modal IsVisible="true" OnClose="CloseAddFromStashModal" ModalDialogClass="modal-fullscreen">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h2 class="mb-0">Add Equipment from Stash</h2>
                <button
                    type="button"
                    class="btn btn-sm btn-secondary"
                    @onclick="CloseAddFromStashModal">
                    <i class="fas fa-times"></i>
                </button>
            </div>
            <EquipmentSelector
                Equipment="@availableStashEquipment"
                ShowTabs="true"
                ShowSearch="true"
                ShowActions="true"
                OnEquipmentSelected="AddEquipmentFromStash" />
        </Modal>
    }
    <!-- Add New Equipment Modal -->
    @if (showAddEquipmentModal && warband != null)
    {
        <Modal IsVisible="true" OnClose="CloseAddEquipmentModal" ModalDialogClass="modal-fullscreen">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h2 class="mb-0">Add Equipment to Character</h2>
                <button
                    type="button"
                    class="btn btn-sm btn-secondary"
                    @onclick="CloseAddEquipmentModal">
                    <i class="fas fa-times"></i>
                </button>
            </div>

            <!-- Toggle between Browse and Create Custom -->
            <div class="btn-group mb-3" role="group">
                <button type="button"
                        class="btn @(showingCustomItemForm ? "btn-outline-primary" : "btn-primary")"
                        @onclick="@(() => showingCustomItemForm = false)">
                    <i class="fas fa-store"></i> Browse Equipment
                </button>
                <button type="button"
                        class="btn @(showingCustomItemForm ? "btn-primary" : "btn-outline-primary")"
                        @onclick="@(() => showingCustomItemForm = true)">
                    <i class="fas fa-plus-circle"></i> Create Custom Item
                </button>
            </div>

            <ValidationErrors Errors="@validationErrors" />

            @if (!showingCustomItemForm)
            {
                <TraderSelector
                    Traders="@availableTraders"
                    SelectedTraderId="@selectedTraderId"
                    SelectedTraderIdChanged="@OnTraderChanged"
                    Label="Select Trader"
                    AllowNone="true"
                    ShowPricingInfo="true" />
                @if (selectedTrader?.HasLimitedInventory == true)
                {
                    <div>
                        <button
                            type="button"
                            class="btn btn-primary"
                            @onclick="RollMerchantInventory">
                            <i class="fas fa-dice"></i>
                            Roll Merchant Inventory
                        </button>
                        @if (merchantInventoryIds.Any())
                        {
                            <span>
                                (@merchantInventoryIds.Count items available)
                            </span>
                            <button
                                type="button"
                                class="btn btn-secondary"
                                @onclick="ClearMerchantInventory">
                                <i class="fas fa-times"></i>
                                Clear
                            </button>
                        }
                    </div>
                }
                <EquipmentSelector
                    Equipment="@GetFilteredEquipment()"
                    ShowTabs="true"
                    ShowSearch="true"
                    ShowPrice="@(!string.IsNullOrEmpty(selectedTraderId))"
                    ShowActions="true"
                    UseCompactMode="true"
                    CurrencySymbol="G"
                    WarbandMoney="@warband?.Gold"
                    PriceCalculator="@CalculateBuyPrice"
                    DisabledEquipmentIds="@GetUnaffordableEquipmentIds()"
                    DisableBuyButton="@(string.IsNullOrEmpty(selectedTraderId) || (selectedTrader?.HasLimitedInventory == true && !merchantInventoryIds.Any()))"
                    AcquiredRelicIds="@(warband?.AcquiredRelicIds ?? new())"
                    OnBuy="@_handleBuyEquipment"
                    OnBuyAndEquip="@_handleBuyEquipmentAndEquip"
                    OnAssign="@AddNewEquipment"
                    OnAssignAndEquip="@_handleAssignAndEquip"
                    OnMarkAcquired="@HandleMarkRelicAcquired"
                    OnMarkAvailable="@HandleMarkRelicAvailable"
                    OnRollRandomRelic="@RollRandomRelic" />
            }
            else
            {
                <!-- Custom Item Form (embedded, not a separate modal) -->
                <div class="custom-item-form-container">
                    @if (validationErrors.Any())
                    {
                        <div class="alert alert-danger">
                            <ul class="mb-0">
                                @foreach (var error in validationErrors)
                                {
                                    <li>@error</li>
                                }
                            </ul>
                        </div>
                    }

                    <div class="mb-3">
                        <label for="customItemName" class="form-label fw-semibold">Item Name <span class="text-danger">*</span></label>
                        <input type="text"
                               class="form-control"
                               id="customItemName"
                               @bind="customItemName"
                               placeholder="Enter item name..."
                               maxlength="50" />
                    </div>

                    <div class="row mb-3">
                        <div class="col-6">
                            <label for="customItemCost" class="form-label fw-semibold">Cost (@GetCurrencySymbol())</label>
                            <NumberInput @bind-Value="customItemCost" Min="0" Max="999" Step="1" />
                        </div>
                        <div class="col-6">
                            <label for="customItemSlots" class="form-label fw-semibold">Slots</label>
                            <NumberInput @bind-Value="customItemSlots" Min="0" Max="10" Step="1" />
                        </div>
                    </div>

                    <div class="mb-3">
                        <label for="customItemEffect" class="form-label fw-semibold">Effect / Description</label>
                        <textarea class="form-control"
                                  id="customItemEffect"
                                  @bind="customItemEffect"
                                  rows="3"
                                  placeholder="Describe what this item does..."
                                  maxlength="200"></textarea>
                        <small class="text-body-secondary">Optional - Describe the item's effect or use</small>
                    </div>

                    <div class="mb-3">
                        <label for="customItemIcon" class="form-label fw-semibold">Icon (Optional)</label>
                        <select class="form-select" id="customItemIcon" @bind="customItemIconClass">
                            <option value="">-- No icon --</option>
                            <option value="fas fa-flask">Flask (fas fa-flask)</option>
                            <option value="fas fa-box">Box (fas fa-box)</option>
                            <option value="fas fa-gem">Gem (fas fa-gem)</option>
                            <option value="fas fa-book">Book (fas fa-book)</option>
                            <option value="fas fa-scroll">Scroll (fas fa-scroll)</option>
                            <option value="fas fa-ring">Ring (fas fa-ring)</option>
                            <option value="fas fa-key">Key (fas fa-key)</option>
                            <option value="fas fa-compass">Compass (fas fa-compass)</option>
                            <option value="fas fa-map">Map (fas fa-map)</option>
                            <option value="fas fa-briefcase">Briefcase (fas fa-briefcase)</option>
                            <option value="fas fa-toolbox">Toolbox (fas fa-toolbox)</option>
                            <option value="fas fa-magic">Magic (fas fa-magic)</option>
                            <option value="fas fa-star">Star (fas fa-star)</option>
                            <option value="fas fa-gift">Gift (fas fa-gift)</option>
                            <option value="ra ra-potion">Potion (ra ra-potion)</option>
                            <option value="ra ra-scroll-unfurled">Scroll Unfurled (ra ra-scroll-unfurled)</option>
                            <option value="ra ra-crystal-wand">Crystal Wand (ra ra-crystal-wand)</option>
                            <option value="ra ra-gem-pendant">Gem Pendant (ra ra-gem-pendant)</option>
                            <option value="ra ra-wooden-sign">Wooden Sign (ra ra-wooden-sign)</option>
                            <option value="ra ra-apple">Apple (ra ra-apple)</option>
                        </select>
                    </div>

                    @if (!string.IsNullOrEmpty(customItemName))
                    {
                        <div class="card bg-light">
                            <div class="card-body">
                                <h6 class="card-title mb-3">Preview:</h6>
                                <div class="d-flex align-items-start gap-3 p-2 border rounded">
                                    <div class="flex-shrink-0 text-primary fs-4">
                                        @if (!string.IsNullOrEmpty(customItemIconClass))
                                        {
                                            <i class="@customItemIconClass"></i>
                                        }
                                        else
                                        {
                                            <i class="fas fa-cube"></i>
                                        }
                                    </div>
                                    <div class="flex-grow-1">
                                        <div class="fw-bold">@customItemName</div>
                                        @if (!string.IsNullOrEmpty(customItemEffect))
                                        {
                                            <div class="small text-body-secondary">@customItemEffect</div>
                                        }
                                        <div class="d-flex flex-wrap gap-2 mt-1">
                                            <span class="badge text-bg-warning">@customItemCost@GetCurrencySymbol()</span>
                                            <span class="badge text-bg-dark">@customItemSlots @(customItemSlots == 1 ? "slot" : "slots")</span>
                                            <span class="badge text-bg-info">Custom</span>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }

                    <div class="d-flex gap-2 mt-3">
                        <button type="button" class="btn btn-primary" @onclick="SaveCustomItemInline" disabled="@customItemSaving">
                            @if (customItemSaving)
                            {
                                <span class="spinner-border spinner-border-sm me-1"></span>
                            }
                            else
                            {
                                <i class="fas fa-save"></i>
                            }
                            Save to Warband
                        </button>
                        <button type="button" class="btn btn-success" @onclick="SaveAndEquipCustomItemInline" disabled="@customItemSaving">
                            @if (customItemSaving)
                            {
                                <span class="spinner-border spinner-border-sm me-1"></span>
                            }
                            else
                            {
                                <i class="fas fa-check"></i>
                            }
                            Save and Equip
                        </button>
                    </div>
                </div>
            }
        </Modal>
    }
    <!-- Feat & Flaw Management Modal -->
    @if (showFeatFlawModal && character != null && warband != null)
    {
        <Modal IsVisible="true" OnClose="CloseFeatFlawModal" ModalDialogClass="modal-fullscreen">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h2 class="mb-0">Manage Feats & Flaws</h2>
                <button
                    type="button"
                    class="btn btn-sm btn-secondary"
                    @onclick="CloseFeatFlawModal">
                    <i class="fas fa-times"></i>
                </button>
            </div>
            <FeatFlawSelector
                AvailableFeats="@availableFeats"
                AvailableFlaws="@availableFlaws"
                CurrentFeats="@character.Feats"
                CurrentFlaws="@character.Flaws"
                OnRollFeat="@(async () => await RollFeat())"
                OnRollFlaw="@(async () => await RollFlaw())"
                OnAddFeat="@AddFeat"
                OnAddFlaw="@AddFlaw"
                OnRemoveFeat="@RemoveFeat"
                OnRemoveFlaw="@RemoveFlaw" />
        </Modal>
    }
    <!-- Injury Management Modal -->
    @if (showInjuryModal && character != null && warband != null)
    {
        <Modal IsVisible="true" OnClose="CloseInjuryModal" ModalDialogClass="modal-fullscreen">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h2 class="mb-0">Manage Injuries</h2>
                <button
                    type="button"
                    class="btn btn-sm btn-secondary"
                    @onclick="CloseInjuryModal">
                    <i class="fas fa-times"></i>
                </button>
            </div>
            <InjurySelector
                AvailableInjuries="@availableInjuries"
                CurrentInjuryNames="@character.Injuries"
                OnRollInjury="@(async () => await RollInjury())"
                OnSelectInjury="@AddInjury"
                OnRemoveInjury="@RemoveInjury" />
        </Modal>
    }
    <!-- Spell Management Modal -->
    @if (showSpellModal && character != null && warband != null)
    {
        <Modal IsVisible="true" OnClose="CloseSpellModal" ModalDialogClass="modal-fullscreen">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h2 class="mb-0">Manage Spells</h2>
                <button
                    type="button"
                    class="btn btn-sm btn-secondary"
                    @onclick="CloseSpellModal">
                    <i class="fas fa-times"></i>
                </button>
            </div>
            <ValidationErrors Errors="@validationErrors" />
            <SpellSelector
                AvailableSpells="@availableSpells"
                CurrentSpellNames="@character.Spells"
                OnSelectSpell="@AddSpell"
                OnRemoveSpell="@RemoveSpell"
                OnDeleteSpell="@DeleteSpell"
                OnRollRandomSpell="@RollRandomSpell" />
        </Modal>
    }
    <!-- Rename Character Modal -->
    @if (showRenameModal)
    {
        <Modal
            IsVisible="true"
            Title="Rename Character"
            OnClose="CloseRenameModal">
            <EditForm Model="editCharacterDto" OnValidSubmit="SaveCharacterName">
                <DataAnnotationsValidator />
                <div class="mb-3">
                    <label for="characterName" class="form-label">Character Name</label>
                    <div class="input-group">
                        <InputText
                            id="characterName"
                            class="form-control"
                            @bind-Value="editCharacterDto.Name"
                            placeholder="Enter character name..." />
                        <button
                            type="button"
                            class="btn btn-secondary"
                            @onclick="GenerateNewCharacterName"
                            title="Generate new random name">
                            <i class="fas fa-dice"></i>
                        </button>
                    </div>
                    <ValidationMessage For="@(() => editCharacterDto.Name)" class="text-danger" />
                </div>
                @if (validationErrors.Any())
                {
                    <aside class="alert alert-danger" role="alert">
                        <strong>Validation Errors:</strong>
                        <ul class="mb-0">
