                IsCustom = true
            };

            // First create the custom item in the warband
            await StateService.CreateCustomItemAsync(warband.Id, customItem);

            // Reload to get the item with its ID
            await LoadData();

            // Find the newly created item
            var createdItem = warband.CustomItems.FirstOrDefault(i => i.Name == customItem.Name);
            if (createdItem != null)
            {
                // Create a copy to add to character
                var itemCopy = new Equipment
                {
                    Id = Guid.NewGuid().ToString(),
                    Name = createdItem.Name,
                    Type = createdItem.Type,
                    Cost = createdItem.Cost,
                    Slots = createdItem.Slots,
                    Effect = createdItem.Effect,
                    IconClass = createdItem.IconClass,
                    IsCustom = true
                };

                await StateService.AddEquipmentToCharacterAsync(warband.Id, character.Id, itemCopy);
                await LoadData();
            }

            // Reset form
            customItemName = string.Empty;
            customItemCost = 0;
            customItemSlots = 1;
            customItemEffect = string.Empty;
            customItemIconClass = string.Empty;
            showingCustomItemForm = false;
            CloseAddEquipmentModal();

            validationErrors.Clear();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to create and equip custom item");
            validationErrors.Add($"Failed to create and equip custom item: {ex.Message}");
        }
        finally
        {
            customItemSaving = false;
            StateHasChanged();
        }
    }

