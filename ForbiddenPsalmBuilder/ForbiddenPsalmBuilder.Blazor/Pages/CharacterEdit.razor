        try
        {
            await StateService.AddSpellAsync(warband.Id, character.Id, spellName);
            await LoadData();
            Logger.LogInformation("Added spell: {SpellName}", spellName);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to add spell");
            validationErrors.Add($"Failed to add spell: {ex.Message}");
            StateHasChanged();
        }
    }

    private async Task RemoveSpell(string spellName)
    {
        if (character == null || warband == null) return;

        try
        {
            await StateService.RemoveSpellAsync(warband.Id, character.Id, spellName);
            await LoadData();
            Logger.LogInformation("Moved spell to stash: {SpellName}", spellName);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to move spell to stash");
            validationErrors.Add($"Failed to move spell to stash: {ex.Message}");
            StateHasChanged();
        }
    }

    private async Task DeleteSpell(string spellName)
    {
        if (character == null || warband == null) return;

        var confirmed = await JSRuntime.InvokeAsync<bool>("confirm", new object[] { $"Permanently delete spell \"{spellName}\"? This cannot be undone." });
        if (!confirmed) return;

        try
        {
            await StateService.DeleteSpellPermanentlyAsync(warband.Id, character.Id, spellName);
            await LoadData();
            Logger.LogInformation("Deleted spell permanently: {SpellName}", spellName);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to delete spell");
            validationErrors.Add($"Failed to delete spell: {ex.Message}");
            StateHasChanged();
        }
    }

    private async Task RollRandomSpell(string category)
    {
        if (character == null || warband == null) return;

        try
        {
            var randomSpell = await SpellService.RollRandomSpellAsync(warband.GameVariant, category);
            if (randomSpell != null)
            {
                await AddSpell(randomSpell.Name);
                Logger.LogInformation("Rolled random {Category} spell: {SpellName}", category, randomSpell.Name);
            }
            else
            {
                Logger.LogWarning("No spells found in category: {Category}", category);
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to roll random spell");
            validationErrors.Add($"Failed to roll random spell: {ex.Message}");
            StateHasChanged();
        }
    }

    private List<SpellOption> GetSpellOptions(List<string> spellNames)
    {
        return spellNames
            .Select(name => availableSpells.FirstOrDefault(s => s.Name == name))
            .Where(s => s != null)
            .Cast<SpellOption>()
            .ToList();
    }
}
