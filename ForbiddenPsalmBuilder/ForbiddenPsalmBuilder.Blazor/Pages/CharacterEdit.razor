    private async Task HandleBuyAmmo(string traderId)
    {
        Logger.LogInformation("HandleBuyAmmo called with traderId: {TraderId}", traderId);
        Logger.LogInformation("Character: {HasChar}, Warband: {HasWarband}, Weapon: {HasWeapon}, AmmoItem: {HasAmmo}",
            character != null, warband != null, weaponToReload != null, ammoForReload != null);
        Logger.LogInformation("Available traders count: {Count}", availableTraders.Count);

        if (character == null || warband == null || weaponToReload == null || ammoForReload == null)
        {
            Logger.LogWarning("Null check failed - returning early");
            return;
        }

        try
        {
            // Get trader for price calculation
            var trader = availableTraders.FirstOrDefault(t => t.Id == traderId);
            if (trader == null)
            {
                Logger.LogError("Trader not found: {TraderId}", traderId);
                validationErrors.Add($"Trader not found: {traderId}");
                StateHasChanged();
                return;
            }

            var price = trader.CalculateBuyPrice(ammoForReload.Cost);
            Logger.LogInformation("Buying ammo for {Price}G from {TraderName}", price, trader.Name);

            // Call backend to buy and add ammo to character
            await StateService.BuyAmmoForWeaponAsync(warband.Id, character.Id, weaponToReload.Id, traderId);
            Logger.LogInformation("Successfully bought ammo");

            // Refresh data
            await LoadData();
            CloseAmmoSelectorModal();
            validationErrors.Clear();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to buy ammo");
            validationErrors.Add($"Failed to buy ammo: {ex.Message}");
            StateHasChanged();
        }
    }

