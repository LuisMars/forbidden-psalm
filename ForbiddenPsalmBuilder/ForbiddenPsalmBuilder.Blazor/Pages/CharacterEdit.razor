    private string GetConsumableEffectDescription(string? effect)
    {
        return effect?.ToLowerInvariant() switch
        {
            "cure_bleeding" => "Cures Bleeding",
            "cure_poisoned" => "Cures Poisoned",
            "cure_disease" => "Cures Disease",
            "heal_hp" => "Heals 1-6 HP",
            "prevent_gas" => "Prevents Gas effects",
            _ => "Unknown effect"
        };
    }

    private async Task SellEquipment(Equipment equipment)
    {
        if (character == null || warband == null || equipment == null) return;

        var sellPrice = equipment.Cost;
        var confirmed = await JSRuntime.InvokeAsync<bool>("confirm", new object[] { $"Sell {equipment.Name} for {sellPrice} Gold?" });
        if (!confirmed) return;

        try
        {
            // Remove equipment from character (moves to stash)
            await StateService.RemoveEquipmentFromCharacterAsync(WarbandId, character.Id, equipment.Id);

            // Sell equipment from stash (removes from stash and adds gold)
            await StateService.SellEquipmentAsync(WarbandId, equipment.Id);

            // Refresh data
