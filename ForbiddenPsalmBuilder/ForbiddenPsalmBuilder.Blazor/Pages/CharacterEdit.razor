    private async Task SaveCustomItemInline()
    {
        if (warband == null) return;

        validationErrors.Clear();

        // Validate inputs
        if (string.IsNullOrWhiteSpace(customItemName))
        {
            validationErrors.Add("Item name is required");
            StateHasChanged();
            return;
        }

        if (customItemName.Length > 50)
        {
            validationErrors.Add("Item name must be 50 characters or less");
            StateHasChanged();
            return;
        }

        if (customItemCost < 0 || customItemCost > 999)
        {
            validationErrors.Add("Cost must be between 0 and 999");
            StateHasChanged();
            return;
        }

        if (customItemSlots < 0 || customItemSlots > 10)
        {
            validationErrors.Add("Slots must be between 0 and 10");
            StateHasChanged();
            return;
        }

        if (customItemEffect.Length > 200)
        {
            validationErrors.Add("Effect description must be 200 characters or less");
            StateHasChanged();
            return;
        }

        customItemSaving = true;
        StateHasChanged();

        try
        {
            var customItem = new Equipment
            {
                Name = customItemName.Trim(),
                Type = "item",
                Cost = customItemCost,
                Slots = customItemSlots,
                Effect = string.IsNullOrWhiteSpace(customItemEffect) ? null : customItemEffect.Trim(),
                IconClass = string.IsNullOrWhiteSpace(customItemIconClass) ? "fas fa-cube" : customItemIconClass,
                IsCustom = true
            };

            await StateService.CreateCustomItemAsync(warband.Id, customItem);
            await LoadData();

            // Reset form
            customItemName = string.Empty;
            customItemCost = 0;
            customItemSlots = 1;
            customItemEffect = string.Empty;
            customItemIconClass = string.Empty;
            showingCustomItemForm = false;

            validationErrors.Clear();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to create custom item");
            validationErrors.Add($"Failed to create custom item: {ex.Message}");
        }
        finally
        {
            customItemSaving = false;
            StateHasChanged();
        }
    }

    private async Task SaveAndEquipCustomItemInline()
    {
        if (warband == null || character == null) return;

        validationErrors.Clear();

        // Validate inputs
        if (string.IsNullOrWhiteSpace(customItemName))
        {
            validationErrors.Add("Item name is required");
            StateHasChanged();
            return;
        }

        if (customItemName.Length > 50)
        {
            validationErrors.Add("Item name must be 50 characters or less");
