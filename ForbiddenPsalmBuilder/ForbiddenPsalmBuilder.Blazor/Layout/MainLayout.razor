@inherits LayoutComponentBase
<div class="d-flex flex-column min-vh-100">
    <main class="flex-grow-1">
    @Body
    </main>
    <footer class="mt-auto py-4 border-top">
        <div class="container-fluid">
            <div class="row align-items-center">
                <div class="col-12 col-md-8">
                    <small class="text-body-secondary">
                        Independent production by
                        <a
                            href="https://github.com/luismars"
                            target="_blank"
                            class="text-decoration-none">
                            luismars
                        </a>
                        ,
                        not affiliated with Ockult Örtmästare Games, Stockholm Kartell, or KRD Designs; published under the
                        <a
                            href="https://morkborg.com/license"
                            target="_blank"
                            class="text-decoration-none">
                            MÖRK BORG Third Party License
                        </a>
                        <br />
                        <a
                            href="https://www.forbiddenpsalm.com"
                            target="_blank"
                            class="text-decoration-none">
                            Forbidden Psalm
                        </a>
                        referenced for compatibility only; no endorsement implied.
                        <p class="mt-2 mb-2">
                            <a
                                href="https://github.com/LuisMars/forbidden-psalm"
                                target="_blank"
                                class="text-decoration-none">
                                Source Code
                            </a>
                            <a
                                href="https://github.com/luismars/forbidden-psalm/issues"
                                target="_blank"
                                class="text-decoration-none">
                                Report Issues
                            </a>
                        </p>
                    </small>
                </div>
                <div class="col-12 col-md-4">
                    <div class="d-flex flex-column gap-2 align-items-md-end">
                        <div class="d-flex align-items-center gap-2">
                            <label
                                for="theme-selector"
                                class="form-label mb-0 small fw-bold text-uppercase"
                                style="letter-spacing: 1px;">
                                Theme:
                            </label>
                            <select
                                id="theme-selector"
                                class="form-select form-select-sm"
                                style="width: auto; min-width: 140px;">
                                <option value="morkborg">MÖRK BORG</option>
                                <option value="default">Default</option>
                                <option value="modern">Modern</option>
                                <option value="elegant">Elegant</option>
                            </select>
                        </div>
                        <div class="d-flex align-items-center gap-2">
                            <span class="small fw-bold text-uppercase" style="letter-spacing: 1px;">
                                Mode:
                            </span>
                            <button
                                id="color-mode-toggle"
                                type="button"
                                class="btn btn-sm btn-primary d-flex align-items-center gap-2"
                                aria-label="Toggle color mode">
                                <i class="fas fa-sun"></i>
                                <span id="color-mode-text">Light</span>
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </footer>
</div>

