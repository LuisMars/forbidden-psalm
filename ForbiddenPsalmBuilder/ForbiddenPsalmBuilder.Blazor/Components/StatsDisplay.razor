@namespace ForbiddenPsalmBuilder.Components

@*
    Custom stats display component with big accent numbers and smaller text labels
*@

<div class="stats-container d-flex flex-wrap gap-2">
    @foreach (var stat in Stats)
    {
        <div class="d-flex flex-column align-items-center justify-content-center px-3 py-2 border rounded @(stat.IsModified ? "border-warning bg-warning bg-opacity-10" : "border-secondary")"
             title="@stat.Title">
            <div class="fs-4 fw-bold text-primary">
                @stat.Value
                @if (stat.IsModified)
                {
                    <i class="fas fa-asterisk fa-xs text-warning" title="Modified by feats/flaws/injuries"></i>
                }
            </div>
            <div class="small text-body-secondary text-uppercase fw-semibold">@stat.Label</div>
        </div>
    }
</div>

@code {
    [Parameter] public List<StatItem> Stats { get; set; } = new();

    public class StatItem
    {
        public string Value { get; set; } = "";
        public string Label { get; set; } = "";
        public string? Title { get; set; }
        public bool IsModified { get; set; } = false;
    }
}